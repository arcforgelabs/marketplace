{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcforgelabs.com/schemas/pr-review-loop/loop-state.schema.json",
  "title": "PR Review Loop State",
  "description": "Structured loop state for a PR-backed agent review loop. Mirrors the managed GitHub PR comment block.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "mode",
    "pass",
    "max_passes",
    "implementer",
    "reviewer",
    "branch",
    "tests",
    "accepted_findings",
    "rejected_findings",
    "next_actor"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "needs-review",
        "needs-fix",
        "tests-failing",
        "clean",
        "blocked",
        "ready-human"
      ],
      "description": "Current loop phase."
    },
    "mode": {
      "type": "string",
      "enum": [
        "local-to-local",
        "local-to-remote",
        "remote-to-remote",
        "remote-to-local"
      ],
      "description": "Coordination mode between implementer and reviewer."
    },
    "pass": {
      "type": "integer",
      "minimum": 1,
      "description": "Current review cycle number."
    },
    "max_passes": {
      "type": "integer",
      "minimum": 1,
      "default": 5,
      "description": "Maximum review cycles before the loop must stop or escalate."
    },
    "implementer": {
      "type": "string",
      "minLength": 1,
      "description": "Adapter responsible for code changes (e.g. claude-code, codex-cloud, human)."
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "description": "Adapter responsible for review (e.g. codex-cli, codex-github, human)."
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Head branch name for the pull request."
    },
    "pr": {
      "type": "integer",
      "minimum": 1,
      "description": "GitHub pull request number."
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Focused test commands to run after fixes."
    },
    "accepted_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PRL-[0-9]{4}$"
      },
      "description": "Finding IDs the implementer must address."
    },
    "rejected_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PRL-[0-9]{4}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Findings dismissed with a recorded reason."
    },
    "next_actor": {
      "type": "string",
      "enum": ["implementer", "reviewer", "human"],
      "description": "Who must act next in the loop."
    },
    "last_review_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of the last ingested review."
    },
    "last_commit": {
      "type": "string",
      "minLength": 7,
      "maxLength": 40,
      "description": "Git commit SHA (short or full) last reviewed or fixed."
    },
    "notes": {
      "type": "string",
      "description": "Optional operator notes."
    }
  }
}
